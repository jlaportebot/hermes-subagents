#!/usr/bin/env python3
"""hsa — drive Hermes Agent workers from a Claude orchestrator.

Every worker is a `hermes -z` one-shot run in its own process session, with its
own run directory (prompt, output, usage, meta) and, normally, its own git
worktree. Multi-turn work resumes the same Hermes session with `followup`.

Subcommands: doctor, worktree, dispatch, status, tail, wait, followup, verify,
loop, review, report, stop, path.  Run `hsa <cmd> -h` for details.
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import re
import shlex
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
RUNS_DIR = Path(os.environ.get("HSA_RUNS_DIR", Path.home() / ".local/state/hermes-subagents/runs"))
HERMES_HOME = Path(os.environ.get("HERMES_HOME", Path.home() / ".hermes"))
HERMES_BIN = os.environ.get("HSA_HERMES_BIN", "hermes")
PREAMBLE = Path(os.environ.get("HSA_PREAMBLE", SKILL_DIR / "references/worker-preamble.md"))
DEFAULT_BUDGET_S = 3 * 3600
DEFAULT_TERMINAL_TIMEOUT_S = 1200
SESSION_MATCH_SLACK_S = 5
TAIL_CHARS = 220
POLL_S = 15
REPORT_SEARCH_PREFIX = 400
REPORT_SCAN_MESSAGES = 60
STOPPED_RC = 143
HERMES_PROCESS_NAME = "hermes"
START_TIME_SLACK_S = 2
STOP_GRACE_S = 20
INTERRUPT_GRACE_S = 30
GHOST_AFTER_S = 45
TIMEOUT_MARGIN_S = 600
RUN_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
MAX_PROMPT_BYTES = 100_000
DEFAULT_VERIFY_TIMEOUT_S = 1800
VERIFY_TIMEOUT_RC = 124
VERIFY_MISSING_RC = 127
WRAPPER_START_SLACK_S = 5
WAIT_MARGIN_S = 600
DB_TIMEOUT_S = 5
SESSION_ENV = "HERMES_SESSION_ID"
MAX_UNTRACKED_BYTES = 1_000_000
ACTIVE_STATES = ("running", "starting")
USAGE_SOURCE = "usage"
STARTING_GRACE_S = 60
SCRIPT_OUTPUT_TAIL = 6000
# Coding workers don't need messaging, cron, memory or skill-authoring tools; fewer tools also means a
# smaller system prompt per call and no side effects on Hermes' own memory/skills.
CODING_TOOLSETS = "terminal,file,code_execution,web,todo"


# ---------------------------------------------------------------- run files
_WARNED: set[str] = set()


def warn_once(key: str, message: str) -> None:
    """One stderr warning per process per problem, so a broken state.db doesn't flood every command."""
    if key in _WARNED:
        return
    _WARNED.add(key)
    print(message, file=sys.stderr)


def load_json_dict(path: Path) -> dict:
    """A JSON object from path; {} for a missing, empty, partial or non-object file."""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


class Run:
    """One worker's run directory: meta.json + per-turn files turn-N.{prompt,out,err,usage}."""

    def __init__(self, run_id: str):
        if not RUN_ID_RE.fullmatch(run_id):
            sys.exit(f"hsa: invalid run id {run_id!r} (letters, digits, . _ -; max 64; no leading . _ -)")
        self.id = run_id
        self.dir = RUNS_DIR / run_id

    @property
    def meta_path(self) -> Path:
        return self.dir / "meta.json"

    def exists(self) -> bool:
        return self.meta_path.exists()

    def meta(self) -> dict:
        return json.loads(self.meta_path.read_text())

    def save(self, meta: dict) -> None:
        """Write the whole meta (dispatch only: nothing else can be touching a brand-new run)."""
        tmp = self.meta_path.with_suffix(f".tmp{os.getpid()}")
        tmp.write_text(json.dumps(meta, indent=2))
        tmp.replace(self.meta_path)

    def patch(self, change) -> dict:
        """Locked read-modify-write of meta.json. `change` is a dict of fields or a function that mutates the
        fresh meta. Concurrent hsa processes (a background `loop`, a foreground `status`) never lose updates."""
        with open(self.dir / "meta.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            fresh = self.meta()
            if callable(change):
                change(fresh)
            else:
                fresh.update(change)
            self.save(fresh)
            return fresh

    @contextlib.contextmanager
    def launch_lock(self):
        """Serialises 'check state, bump turn, launch'. A file separate from meta.lock: patch() inside it
        would deadlock on a second open of the same lock file."""
        with open(self.dir / "launch.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            yield

    def turn_file(self, turn: int, kind: str) -> Path:
        return self.dir / f"turn-{turn}.{kind}"

    def done_marker(self, turn: int) -> Path:
        return self.turn_file(turn, "done")


def require_run(run_id: str) -> Run:
    run = Run(run_id)
    if not run.exists():
        sys.exit(f"hsa: no run named {run_id!r} in {RUNS_DIR}")
    return run


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    stat = Path(f"/proc/{pid}/stat")
    return not (stat.exists() and stat.read_text().split(") ")[-1].startswith("Z"))


def is_wrapper(meta: dict) -> bool:
    """The turn's shell wrapper is still alive. A bare pid check is fooled by PID reuse after a reboot or a
    long idle, so also require a bash that started when the turn did (unknown start time: trust the pid)."""
    pid = meta.get("pid")
    if not pid_alive(pid):
        return False
    started = proc_started_at(pid)
    if not started:
        return True
    return proc_comm(pid) == "bash" and abs(started - (meta.get("turn_started_at") or 0)) <= WRAPPER_START_SLACK_S


def read_marker(path: Path) -> tuple[int, float] | None:
    """(exit code, finish time) from a done marker; None if absent. Empty or garbled content counts as
    failed (rc 1) with the file's mtime, so a truncated marker never crashes a reader."""
    try:
        parts = path.read_bytes().decode(errors="replace").split()
        mtime = path.stat().st_mtime
    except OSError:
        return None
    try:
        rc = int(parts[0])
    except (IndexError, ValueError):
        rc = 1
    try:
        finished = float(parts[1])
    except (IndexError, ValueError):
        finished = mtime
    return rc, finished


def starting_or_dead(run: Run, meta: dict) -> str:
    """A meta without a pid is a launch in progress, unless it has been that way for a while: then the
    dispatch died between saving the meta and launching, and the run counts as crashed."""
    try:
        born = meta.get("created_at") or run.meta_path.stat().st_mtime
    except OSError:
        return "crashed"
    if time.time() - born <= STARTING_GRACE_S:
        return "starting"
    return "stopped" if meta.get("stopped") else "crashed"


def turn_state(run: Run, meta: dict) -> str:
    """starting | running | done | failed | stopped | crashed for the latest turn."""
    marker = read_marker(run.done_marker(meta.get("turn", 1)))
    if marker:
        if meta.get("stopped"):
            return "stopped"
        return "done" if marker[0] == 0 else "failed"
    if not meta.get("pid"):
        return starting_or_dead(run, meta)
    if is_wrapper(meta):
        return "running"
    return "stopped" if meta.get("stopped") else "crashed"


# ------------------------------------------------------------ hermes state.db
def db_rows(sql: str, params: tuple = ()) -> list[tuple] | None:
    """Rows from Hermes' state.db, or None when it is absent or unreadable (one warning per process)."""
    path = HERMES_HOME / "state.db"
    if not path.exists():
        return None
    try:
        with contextlib.closing(sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=DB_TIMEOUT_S)) as db:
            return db.execute(sql, params).fetchall()
    except sqlite3.Error as err:
        warn_once("state-db", f"hsa: warning: cannot read Hermes state.db ({err}); live monitoring disabled")
        return None


def find_session(meta: dict) -> str | None:
    """Session id from state.db: the one session whose cwd is the workdir and that started with this turn.
    Several candidates (two workers in one directory) are ambiguous, so don't guess."""
    if not meta.get("workdir") or not meta.get("turn_started_at"):
        return None
    rows = db_rows("select id from sessions where cwd=? and started_at>=?",
                   (meta["workdir"], meta["turn_started_at"] - SESSION_MATCH_SLACK_S))
    ids = {row[0] for row in rows or []}
    if len(ids) > 1:
        warn_once("ambiguous-session", f"hsa: warning: {len(ids)} Hermes sessions match {meta['workdir']}; "
                  "not guessing a session id (give each worker its own worktree)")
    return ids.pop() if len(ids) == 1 else None


def session_info(session_id: str | None) -> dict:
    rows = db_rows(
        "select api_call_count, tool_call_count, input_tokens, output_tokens, last_activity_at,"
        " last_activity_description, ended_at, end_reason from sessions where id=?",
        (session_id,),
    ) if session_id else None
    if not rows:
        return {}
    keys = ["api_calls", "tool_calls", "input_tokens", "output_tokens", "last_activity_at",
            "last_activity", "ended_at", "end_reason"]
    return dict(zip(keys, rows[0]))


def session_messages(session_id: str | None, limit: int) -> list[tuple]:
    if not session_id:
        return []
    rows = db_rows("select role, content, tool_name, tool_calls, timestamp from messages"
                   " where session_id=? order by id desc limit ?", (session_id, limit))
    return list(reversed(rows or []))


def read_usage(run: Run, turn: int) -> dict:
    return load_json_dict(run.turn_file(turn, "usage"))


def usage_session_id(run: Run, turn: int) -> str | None:
    session_id = read_usage(run, turn).get("session_id")
    return session_id if isinstance(session_id, str) and session_id else None


def refresh_session(run: Run, meta: dict) -> dict:
    """Return the run's latest meta, recording its Hermes session id once it is known. The usage file is
    authoritative and overrides an earlier state.db guess; the guess only fills the gap while a turn runs."""
    meta = run.meta()
    if meta.get("session_source") == USAGE_SOURCE:
        return meta
    found = usage_session_id(run, meta.get("turn", 1))
    source = USAGE_SOURCE
    if not found:
        found, source = (None, "") if meta.get("session_id") else (find_session(meta), "statedb")
    if not found or (meta.get("session_id"), meta.get("session_source")) == (found, source):
        return meta

    def record(fresh: dict) -> None:
        if fresh.get("session_source") != USAGE_SOURCE:
            fresh.update(session_id=found, session_source=source)

    return run.patch(record)


# ------------------------------------------------------------------ launching
def build_prompt(brief_text: str, use_preamble: bool, run_id: str, workdir: str, base: str | None) -> str:
    header = f"Task id: {run_id}\nWorking directory: {workdir}\n"
    if base:
        header += f"Base commit: {base}\n"
    if not use_preamble:
        return f"{header}\n{brief_text}"
    return f"{PREAMBLE.read_text()}\n\n---\n\n{header}\n{brief_text}"


def check_prompt_size(prompt: str) -> None:
    size = len(prompt.encode())
    if size > MAX_PROMPT_BYTES:
        sys.exit(f"hsa: prompt is {size} bytes, over the {MAX_PROMPT_BYTES} limit: Linux caps one argv element at "
                 "128 KiB; move long material (specs, logs) into a file and name it in the brief.")


def hermes_argv(meta: dict, prompt_file: Path, usage_file: Path, resume: str | None) -> list[str]:
    argv = [HERMES_BIN, "-z", prompt_file.read_text(), "--in", meta["workdir"], "--yolo",
            "--reasoning", meta["reasoning"], "--usage-file", str(usage_file)]
    if meta.get("model"):
        argv += ["-m", meta["model"]]
    if meta.get("provider"):
        argv += ["--provider", meta["provider"]]
    if meta.get("toolsets"):
        argv += ["-t", meta["toolsets"]]
    if meta.get("skills"):
        argv += ["--skills", meta["skills"]]
    if meta.get("clean"):
        argv += ["--ignore-rules"]
    if resume:
        argv += ["--resume", resume]
    return argv


def launch_turn(run: Run, meta: dict, prompt: str, resume: str | None) -> None:
    """Start turn meta['turn'] detached in its own session; a shell wrapper writes the done marker."""
    turn = meta["turn"]
    prompt_file = run.turn_file(turn, "prompt")
    prompt_file.write_text(prompt)
    argv = hermes_argv(meta, prompt_file, run.turn_file(turn, "usage"), resume)
    budget = int(meta["budget_s"])
    inner = " ".join(shlex.quote(a) for a in ["timeout", "-k", "30", str(budget), *argv])
    marker = shlex.quote(str(run.done_marker(turn)))
    script = f'{inner}; rc=$?; echo "$rc $(date +%s)" > {marker}.tmp && mv {marker}.tmp {marker}'
    env = dict(os.environ)
    env.setdefault("TERMINAL_TIMEOUT", str(meta["terminal_timeout_s"]))
    env.setdefault("TERMINAL_MAX_FOREGROUND_TIMEOUT", str(meta["terminal_timeout_s"] + TIMEOUT_MARGIN_S))
    # Hermes' per-batch tool guard (default 420 s) would otherwise cut long foreground commands short.
    env.setdefault("HERMES_CONCURRENT_TOOL_TIMEOUT_S", str(meta["terminal_timeout_s"] + 2 * TIMEOUT_MARGIN_S))
    with open(run.turn_file(turn, "out"), "w") as out, open(run.turn_file(turn, "err"), "w") as err:
        proc = subprocess.Popen(["bash", "-c", script], stdin=subprocess.DEVNULL, stdout=out,
                                stderr=err, env=env, cwd=meta["workdir"], start_new_session=True)
    started = time.time()
    entry = {"turn": turn, "started_at": started, "prompt_chars": len(prompt)}

    def record(fresh: dict) -> None:
        fresh.update(turn=turn, pid=proc.pid, turn_started_at=started, stopped=False,
                     budget_s=meta["budget_s"], turns=[*fresh.get("turns", []), entry])
        fresh.pop("stopped_at", None)

    meta.update(run.patch(record))


def ignore_scratch(workdir: str) -> None:
    """Keep the worker scratch dir `.hsa-tmp/` out of git without touching tracked files."""
    git_dir = git(workdir, "rev-parse", "--git-common-dir")
    if not git_dir:
        return
    exclude = (Path(workdir) / git_dir if not os.path.isabs(git_dir) else Path(git_dir)) / "info/exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    text = exclude.read_text() if exclude.exists() else ""
    if ".hsa-tmp/" not in text.split():
        exclude.write_text(text + ("" if text.endswith("\n") or not text else "\n") + ".hsa-tmp/\n")


def prepare_run_dir(run: Run, force: bool) -> None:
    """Create the run dir, replacing an old run only with --force and only if it is an idle hsa run dir."""
    if not run.dir.exists():
        run.dir.mkdir(parents=True)
        return
    if not run.exists():
        if any(run.dir.iterdir()):
            sys.exit(f"hsa: {run.dir} exists and is not an hsa run dir; remove it yourself")
        return
    if not force:
        sys.exit(f"hsa: run {run.id!r} exists (use --force to replace, or `hsa followup`)")
    try:
        state = turn_state(run, run.meta())
    except (OSError, ValueError):
        state = "crashed"
    if state in ACTIVE_STATES:
        sys.exit(f"hsa: run {run.id!r} is {state}; `hsa stop {run.id}` it before --force")
    shutil.rmtree(run.dir)
    run.dir.mkdir(parents=True)


def read_brief(path: str) -> str:
    try:
        return Path(path).read_text()
    except OSError as err:
        sys.exit(f"hsa: cannot read brief {path}: {err}")


def busy_workers(workdir: str, own_id: str) -> list[str]:
    return [r.id for r, m in all_run_metas() if r.id != own_id and m.get("workdir") == workdir
            and turn_state(r, m) in ACTIVE_STATES]


def new_meta(args: argparse.Namespace, workdir: str, base: str | None) -> dict:
    return {
        "id": args.id, "workdir": workdir, "brief": str(Path(args.brief).resolve()),
        "reasoning": args.reasoning, "model": args.model, "provider": args.provider,
        "toolsets": CODING_TOOLSETS if args.coding and not args.toolsets else args.toolsets,
        "skills": args.skills, "clean": args.clean,
        "budget_s": args.budget, "terminal_timeout_s": args.terminal_timeout,
        "verify": str(Path(args.verify).resolve()) if args.verify else None,
        "verify_timeout_s": args.verify_timeout,
        "base": base, "created_at": time.time(), "turn": 1,
    }


def cmd_dispatch(args: argparse.Namespace) -> None:
    run = Run(args.id)
    workdir = str(Path(args.workdir).resolve())
    if not Path(workdir).is_dir():
        sys.exit(f"hsa: workdir {workdir} does not exist")
    brief = read_brief(args.brief)
    if args.verify and not Path(args.verify).is_file():
        sys.exit(f"hsa: verify script {args.verify} not found")
    base = args.base or git_head(workdir)
    prompt = build_prompt(brief, not args.no_preamble, args.id, workdir, base)
    check_prompt_size(prompt)
    busy = busy_workers(workdir, args.id)
    if busy and not args.share_workdir:
        sys.exit(f"hsa: {workdir} already has a running worker ({', '.join(busy)}); "
                 "give each worker its own worktree (`hsa worktree`) or pass --share-workdir")
    if is_broad_dir(workdir):
        print(f"hsa: warning: {workdir} is a broad directory; give workers a dedicated worktree "
              "(`hsa worktree`) — `hsa stop` will not sweep commands there", file=sys.stderr)
    prepare_run_dir(run, args.force)
    ignore_scratch(workdir)
    shutil.copy(args.brief, run.dir / "brief.md")
    meta = new_meta(args, workdir, base)
    run.save(meta)
    launch_turn(run, meta, prompt, None)
    print(f"dispatched {args.id}: pid {meta['pid']}  workdir {workdir}  base {meta['base']}")
    print(f"run dir {run.dir}")


def cmd_followup(args: argparse.Namespace) -> None:
    run = require_run(args.id)
    message = Path(args.file).read_text() if args.file else args.message
    if not message:
        sys.exit("hsa: give a message or -f FILE")
    if not args.raw:
        message += REPORT_REMINDER
    check_prompt_size(message)
    with run.launch_lock():
        meta = refresh_session(run, run.meta())
        if turn_state(run, meta) in ACTIVE_STATES:
            sys.exit(f"hsa: {args.id} is still running turn {meta.get('turn', 1)}; wait or stop it first")
        if not meta.get("session_id"):
            sys.exit(f"hsa: no Hermes session id recorded for {args.id}; cannot resume")
        if is_ghost(meta, session_info(meta["session_id"])):
            print(f"hsa: note: {args.id} is a ghost (its stopped turn still runs in the Hermes gateway); "
                  "this message is queued and runs after that turn ends", file=sys.stderr)
        if args.budget:
            meta["budget_s"] = args.budget
        meta["turn"] = meta.get("turn", 1) + 1
        launch_turn(run, meta, message, meta["session_id"])
    print(f"follow-up turn {meta['turn']} for {args.id}: pid {meta['pid']} session {meta['session_id']}")


# ------------------------------------------------------------------ observing
def all_run_metas() -> list[tuple[Run, dict]]:
    """Every run with a readable meta.json. Directories that aren't run ids (like `_doctor`) are skipped, and
    a corrupt meta.json gets one warning instead of taking every command down."""
    if not RUNS_DIR.exists():
        return []
    found = []
    for path in sorted(RUNS_DIR.iterdir()):
        if not RUN_ID_RE.fullmatch(path.name) or not (path / "meta.json").exists():
            continue
        run = Run(path.name)
        try:
            meta = run.meta()
            if not isinstance(meta, dict):
                raise ValueError("not a JSON object")
        except (OSError, ValueError) as err:
            warn_once(f"bad-meta-{path.name}", f"hsa: warning: skipping run {path.name}: unreadable meta.json ({err})")
            continue
        found.append((run, meta))
    return found


def all_runs() -> list[Run]:
    return [run for run, _ in all_run_metas()]


def fmt_age(seconds: float | None) -> str:
    if seconds is None:
        return "-"
    seconds = int(seconds)
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m" if seconds >= 3600 else f"{seconds // 60}m{seconds % 60:02d}s"


def is_ghost(meta: dict, info: dict) -> bool:
    """Stopped locally, but the Hermes session is still open and recorded activity after the stop."""
    stopped_at, last = meta.get("stopped_at"), info.get("last_activity_at")
    return bool(stopped_at and last and not info.get("ended_at") and last > stopped_at + GHOST_AFTER_S)


def effective_state(run: Run, meta: dict) -> str:
    """turn_state, with a stopped turn that keeps running server-side reported as 'ghost'."""
    state = turn_state(run, meta)
    if state == "stopped" and is_ghost(meta, session_info(meta.get("session_id"))):
        return "ghost"
    return state


def run_summary(run: Run) -> dict:
    meta = refresh_session(run, run.meta())
    state = effective_state(run, meta)
    info = session_info(meta.get("session_id"))
    marker = read_marker(run.done_marker(meta.get("turn", 1)))
    started = meta.get("turn_started_at")
    finished = marker[1] if marker else time.time()
    last = info.get("last_activity_at")
    return {"id": run.id, "state": state, "turn": meta.get("turn", 1), "api_calls": info.get("api_calls"),
            "tools": info.get("tool_calls"), "elapsed": fmt_age(finished - started if started else None),
            "idle": fmt_age(time.time() - last) if (last and state == "running") else "-",
            "activity": (info.get("last_activity") or "")[:60], "workdir": meta.get("workdir", "")}


def cmd_status(args: argparse.Namespace) -> None:
    runs = [require_run(i) for i in args.ids] if args.ids else all_runs()
    rows = [run_summary(r) for r in runs]
    if args.active:
        rows = [r for r in rows if r["state"] == "running"]
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    print(f"{'id':<22} {'state':<8} {'turn':>4} {'calls':>5} {'tools':>5} {'elapsed':>8} {'idle':>7}  activity")
    for r in rows:
        print(f"{r['id']:<22} {r['state']:<8} {r['turn']:>4} {r['api_calls'] or 0:>5} {r['tools'] or 0:>5} "
              f"{r['elapsed']:>8} {r['idle']:>7}  {r['activity']}")


def describe_message(role: str, content: str | None, tool_name: str | None, tool_calls: str | None) -> str:
    if role == "assistant" and tool_calls:
        try:
            calls = json.loads(tool_calls)
        except json.JSONDecodeError:
            return f"assistant -> {tool_calls[:TAIL_CHARS]}"
        parts = []
        for call in calls:
            fn = call.get("function", {})
            parts.append(f"{fn.get('name')}({(fn.get('arguments') or '')[:TAIL_CHARS]})")
        text = f" | says: {content[:TAIL_CHARS]}" if content else ""
        return "CALL " + "; ".join(parts) + text
    body = (content or "").replace("\n", " ")[:TAIL_CHARS]
    return f"{'RESULT ' + str(tool_name) if role == 'tool' else role.upper()}: {body}"


def cmd_tail(args: argparse.Namespace) -> None:
    run = require_run(args.id)
    meta = refresh_session(run, run.meta())
    sid = meta.get("session_id")
    if not sid:
        print("no session yet (Hermes still starting up)")
        return
    for role, content, tool_name, tool_calls, ts in session_messages(sid, args.n):
        stamp = time.strftime("%H:%M:%S", time.localtime(ts)) if ts is not None else "--:--:--"
        print(f"{stamp} {describe_message(role, content, tool_name, tool_calls)}")


def wait_deadline(runs: list[Run], timeout: int | None) -> float:
    """--timeout seconds from now, else the latest budget end among the runs plus a margin, so a wait on a
    wrapper that vanished without a marker can never hang forever."""
    if timeout:
        return time.time() + timeout
    ends = []
    for run in runs:
        meta = run.meta()
        ends.append((meta.get("turn_started_at") or time.time()) + (meta.get("budget_s") or DEFAULT_BUDGET_S) + WAIT_MARGIN_S)
    return max(ends)


def cmd_wait(args: argparse.Namespace) -> None:
    """Block until all (or --any) named runs finish their current turn; prints a status line per change."""
    runs = [require_run(i) for i in args.ids]
    deadline = wait_deadline(runs, args.timeout)
    seen: dict[str, str] = {}
    while True:
        states = {r.id: turn_state(r, r.meta()) for r in runs}
        for rid, st in states.items():
            if seen.get(rid) != st:
                print(f"{time.strftime('%H:%M:%S')} {rid}: {st}", flush=True)
        seen = states
        finished = [rid for rid, st in states.items() if st not in ACTIVE_STATES]
        if (args.any and finished) or len(finished) == len(runs):
            return
        if time.time() > deadline:
            active = ", ".join(r for r, s in states.items() if s in ACTIVE_STATES)
            sys.exit(f"hsa wait: timeout; still running: {active}" if args.timeout
                     else f"hsa wait: {active} still running past budget + 10 min")
        time.sleep(POLL_S)


# --------------------------------------------------------------- controlling
def child_map() -> dict[int, list[int]]:
    children: dict[int, list[int]] = {}
    for stat in Path("/proc").glob("[0-9]*/stat"):
        try:
            fields = stat.read_text().rsplit(") ", 1)[1].split()
        except (OSError, IndexError):
            continue
        children.setdefault(int(fields[1]), []).append(int(stat.parent.name))
    return children


def process_tree(root: int) -> list[int]:
    """root and all its descendants. Needed because `timeout` and Hermes' terminal tool start their
    children in new process groups/sessions, so killpg on the wrapper alone leaves Hermes running."""
    children, tree, todo = child_map(), [], [root]
    while todo:
        pid = todo.pop()
        tree.append(pid)
        todo.extend(children.get(pid, []))
    return tree


def signal_all(pids: list[int], sig: int) -> None:
    for pid in pids:
        try:
            os.kill(pid, sig)
        except (ProcessLookupError, PermissionError):
            continue


def wait_gone(pids: list[int], seconds: int) -> list[int]:
    for _ in range(seconds):
        if not any(pid_alive(p) for p in pids):
            return []
        time.sleep(1)
    return [p for p in pids if pid_alive(p)]


def proc_cwd(pid: int) -> str:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def proc_comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def parent_of(pid: int) -> int:
    try:
        return int(Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[1])
    except (OSError, IndexError, ValueError):
        return 0


def ancestors(pid: int) -> list[int]:
    chain, current = [], parent_of(pid)
    while current > 1:
        chain.append(current)
        current = parent_of(current)
    return chain


def proc_started_at(pid: int) -> float:
    """Process start as a Unix timestamp (0.0 if unknown)."""
    try:
        ticks = int(Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[19])
        boot = next(int(line.split()[1]) for line in Path("/proc/stat").read_text().splitlines()
                    if line.startswith("btime "))
    except (OSError, IndexError, ValueError, StopIteration):
        return 0.0
    return boot + ticks / os.sysconf("SC_CLK_TCK")


def proc_session_id(pid: int) -> str | None:
    """The Hermes session a process belongs to: Hermes' terminal tool tags every command it runs with
    HERMES_SESSION_ID in the environment."""
    try:
        environ = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return None
    prefix = f"{SESSION_ENV}=".encode()
    for item in environ.split(b"\0"):
        if item.startswith(prefix):
            return item[len(prefix):].decode(errors="replace")
    return None


def is_inside(path: str, directory: str) -> bool:
    return path == directory or path.startswith(directory.rstrip("/") + "/")


def has_repo_child(workdir: str) -> bool:
    """A folder of repos: not a repo itself (submodule checkouts don't count) but with a repo child."""
    if (Path(workdir) / ".git").exists():
        return False
    try:
        return any((child / ".git").exists() for child in Path(workdir).iterdir() if child.is_dir())
    except OSError:
        return False


def is_broad_dir(workdir: str) -> bool:
    """/, $HOME, its ancestors, top-level dirs, and folders of repos: places where unrelated work lives."""
    home = str(Path.home())
    return (workdir in {"/", home} or is_inside(home, workdir) or Path(workdir).parent == Path("/")
            or has_repo_child(workdir))


def protected_pids() -> set[int]:
    return {os.getpid(), *ancestors(os.getpid())}


def hermes_spawned_in(workdir: str, since: float, skip_dirs: tuple[str, ...] = ()) -> list[int]:
    """Fallback sweep when the session id is unknown: processes started during this turn, whose cwd is inside
    the worker's workdir (but not inside `skip_dirs`) and that descend from a process named exactly `hermes`."""
    protected = protected_pids()
    found = []
    for entry in Path("/proc").glob("[0-9]*"):
        pid = int(entry.name)
        cwd = proc_cwd(pid)
        if pid in protected or not is_inside(cwd, workdir) or any(is_inside(cwd, d) for d in skip_dirs):
            continue
        if proc_started_at(pid) + START_TIME_SLACK_S < since:
            continue
        if any(proc_comm(a) == HERMES_PROCESS_NAME for a in ancestors(pid)):
            found.append(pid)
    return found


def session_commands(sid: str, workdir: str, since: float) -> list[int]:
    """Commands Hermes ran for session `sid`: tagged with it, cwd in the workdir, started since the run began.
    The cwd and age checks exclude the gateway's own helpers, which can carry a stale session tag."""
    protected = protected_pids()
    found = []
    for entry in Path("/proc").glob("[0-9]*"):
        pid = int(entry.name)
        if pid in protected or not is_inside(proc_cwd(pid), workdir):
            continue
        if proc_started_at(pid) + START_TIME_SLACK_S < since:
            continue
        if proc_session_id(pid) == sid:
            found.append(pid)
    return found


def proc_cmdline(pid: int) -> list[str]:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [part.decode(errors="replace") for part in raw.split(b"\0")]


def gateway_cwd_inside(workdir: str) -> int | None:
    """Pid of a running Hermes gateway whose cwd is in the workdir: its helper processes inherit that cwd
    (and may carry a stale session tag), so the workdir can't be swept safely."""
    for entry in Path("/proc").glob("[0-9]*"):
        pid = int(entry.name)
        if proc_comm(pid) == HERMES_PROCESS_NAME and "gateway" in proc_cmdline(pid)[1:] \
                and is_inside(proc_cwd(pid), workdir):
            return pid
    return None


def no_sweep_reason(workdir: str) -> str | None:
    if is_broad_dir(workdir):
        return f"{workdir} is a broad directory"
    gateway = gateway_cwd_inside(workdir)
    if gateway:
        return f"a Hermes gateway (pid {gateway}) runs inside {workdir}"
    home = str(HERMES_HOME.resolve())
    if is_inside(home, workdir):
        return f"{workdir} is or contains the Hermes home"
    return None


def peer_workdirs(run: Run) -> list[tuple[str, str]]:
    """(workdir, state) of every other run that is not finished cleanly."""
    states = [(m.get("workdir", ""), turn_state(r, m)) for r, m in all_run_metas() if r.id != run.id]
    return [(workdir, state) for workdir, state in states if state != "done"]


def pick_sweep(run: Run, meta: dict, killed_client: bool) -> tuple[list[int], str]:
    """Processes to kill after the client is dealt with, and how to describe the result. The cwd heuristic
    relies on the current turn's start time, so it only runs when a live client was just killed."""
    workdir = meta.get("workdir", "")
    reason = no_sweep_reason(workdir)
    if reason:
        return [], f"no sweep: {reason}"
    sid = meta.get("session_id")
    since = meta.get("created_at") or meta.get("turn_started_at") or 0
    if sid:
        pids = session_commands(sid, workdir, since)
        return pids, f"swept {len(pids)} commands tagged with session {sid}"
    if not killed_client:
        return [], "no sweep: session id unknown and no live client to anchor a cwd heuristic"
    peers = peer_workdirs(run)
    if any(is_inside(workdir, other) for other, _ in peers if other):
        return [], "no sweep: session id unknown and another unfinished run shares this workdir"
    nested = tuple(other for other, _ in peers if other and other != workdir and is_inside(other, workdir))
    pids = hermes_spawned_in(workdir, meta.get("turn_started_at") or 0, nested)
    return pids, f"swept {len(pids)} commands (cwd heuristic: session id unknown)"


def write_stop_marker(marker: Path) -> None:
    """Create the done marker for a stopped turn without clobbering one the wrapper wrote meanwhile."""
    tmp = marker.with_name(f"{marker.name}.stop{os.getpid()}")
    tmp.write_text(f"{STOPPED_RC} {int(time.time())}\n")
    try:
        os.link(tmp, marker)
    except FileExistsError:
        pass
    finally:
        tmp.unlink()


def kill_client_tree(pid: int) -> tuple[int, int]:
    """SIGINT (Hermes' own Ctrl+C path), then SIGTERM, then SIGKILL on the wrapper's whole process tree.
    Returns (tree size, processes that needed SIGKILL)."""
    tree = process_tree(pid)
    signal_all(tree[1:], signal.SIGINT)
    survivors = wait_gone(tree, INTERRUPT_GRACE_S)
    signal_all(survivors, signal.SIGTERM)
    survivors = wait_gone(survivors, STOP_GRACE_S)
    signal_all(survivors, signal.SIGKILL)
    return len(tree), len(survivors)


def mark_stopped(run: Run, marker: Path) -> bool:
    """Flag the turn stopped unless it finished meanwhile; True when flagged."""
    flagged = []

    def change(fresh: dict) -> None:
        if not marker.exists():
            fresh.update(stopped=True, stopped_at=time.time())
            flagged.append(True)

    run.patch(change)
    return bool(flagged)


def cmd_stop(args: argparse.Namespace) -> None:
    """Stop a worker. Also usable on a finished or crashed run: a ghost turn on a gateway keeps running and
    may restart commands, so the session-tagged sweep runs in every case."""
    run = require_run(args.id)
    meta = run.meta()
    marker = run.done_marker(meta.get("turn", 1))
    killed = False
    if marker.exists():
        case = "client not running (turn already finished)"
    elif not mark_stopped(run, marker):
        case = "client not running (turn already finished)"
    elif is_wrapper(meta):
        tree_size, needed_kill = kill_client_tree(meta["pid"])
        killed = True
        case = f"stopped {tree_size} client processes ({needed_kill} needed SIGKILL)"
        write_stop_marker(marker)
    else:
        case = "client not running (marked stopped)"
        write_stop_marker(marker)
    meta = refresh_session(run, run.meta())
    swept, how = pick_sweep(run, meta, killed)
    signal_all(swept, signal.SIGTERM)
    signal_all(wait_gone(swept, STOP_GRACE_S), signal.SIGKILL)
    print(f"{args.id}: {case}; {len(swept)} Hermes-spawned commands in the workdir ({how}). "
          f"`hsa status {args.id}` shows 'ghost' if the Hermes session keeps running server-side.")


def git(workdir: str, *argv: str) -> str:
    proc = subprocess.run(["git", "-C", workdir, *argv], capture_output=True, text=True)
    return proc.stdout.strip() if proc.returncode == 0 else ""


def git_head(workdir: str) -> str | None:
    return git(workdir, "rev-parse", "HEAD") or None


def cmd_worktree(args: argparse.Namespace) -> None:
    repo = str(Path(args.repo).resolve())
    path = Path(args.path or Path(repo).parent / f"wt-{args.branch.replace('/', '-')}").resolve()
    base = args.base or "HEAD"
    proc = subprocess.run(["git", "-C", repo, "worktree", "add", "-b", args.branch, str(path), base],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        sys.exit(f"hsa worktree: {proc.stderr.strip()}")
    print(path)


def run_verify(run: Run, meta: dict) -> tuple[int, str]:
    script = meta.get("verify")
    if not script:
        return 0, "(no verify script)"
    if not Path(script).is_file():
        return VERIFY_MISSING_RC, f"(verify script {script} not found)"
    turn = meta.get("turn", 1)
    rc, output = run_script(script, meta, run.turn_file(turn, "verify"))
    record = {"turn": turn, "rc": rc, "at": time.time()}
    meta.update(run.patch(lambda fresh: fresh.update(verifications=[*fresh.get("verifications", []), record])))
    run.turn_file(turn, "verify").write_text(output)
    return rc, output


def tail_of(path: Path) -> str:
    try:
        return path.read_bytes()[-SCRIPT_OUTPUT_TAIL:].decode(errors="replace")
    except OSError:
        return ""


def run_script(script: str, meta: dict, out_path: Path) -> tuple[int, str]:
    """Run the acceptance script with no stdin and a time limit. Output goes to a file, not pipes, so a
    daemon the script leaves behind can neither block us nor turn a passing script into a timeout; only the
    script itself is waited for, and a timeout kills its whole process group."""
    limit = meta.get("verify_timeout_s", DEFAULT_VERIFY_TIMEOUT_S)
    with open(out_path, "wb") as out:
        proc = subprocess.Popen(["bash", script], cwd=meta["workdir"], stdin=subprocess.DEVNULL, stdout=out,
                                stderr=subprocess.STDOUT, start_new_session=True,
                                env={**os.environ, "HSA_WORKDIR": meta["workdir"], "HSA_BASE": meta.get("base") or ""})
        try:
            proc.wait(timeout=limit)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
            return VERIFY_TIMEOUT_RC, f"(verify timed out after {limit} s)\n" + tail_of(out_path)
    return proc.returncode, tail_of(out_path)


def cmd_verify(args: argparse.Namespace) -> None:
    run = require_run(args.id)
    rc, output = run_verify(run, run.meta())
    print(output)
    print(f"VERIFY {'PASS' if rc == 0 else 'FAIL'} (rc={rc})")
    sys.exit(rc)


REPORT_REMINDER = """

---
When you finish this turn, your final answer must START with the `STATUS:` line and use exactly these
headings, in order, under 40 lines: STATUS / COMMITS / CHANGES / ACCEPTANCE / TESTS ADDED / NOT DONE / RISKS
(the format from your worker rules). Real command output only."""

FIX_TEMPLATE = """The orchestrator re-ran the acceptance check for your task and it FAILED (exit {rc}).
Output (last part):
```
{output}
```
Find the root cause, fix it in the same working directory, re-run the check yourself
(`bash {script}` from {workdir}) until it passes, commit, and end with the same final report format
(put the passing check output under ACCEPTANCE). If you are blocked, explain exactly what blocks you."""


def loop_fail(message: str, code: int) -> None:
    print(message, file=sys.stderr if code == 2 else sys.stdout)
    sys.exit(code)


def cmd_loop(args: argparse.Namespace) -> None:
    """wait -> verify -> (on fail) follow-up with the failure, up to --max-fixes rounds. Zero orchestrator tokens.
    A stopped worker ends the loop (it was stopped on purpose); a crash is retried once."""
    run = require_run(args.id)
    if not run.meta().get("verify"):
        loop_fail(f"hsa loop: {args.id} has no verify script (dispatch with --verify)", 2)
    crashes = 0
    for attempt in range(args.max_fixes + 1):
        cmd_wait(argparse.Namespace(ids=[args.id], any=False, timeout=None))
        meta = refresh_session(run, run.meta())
        state = effective_state(run, meta)
        if state in ("stopped", "ghost"):
            loop_fail(f"turn {meta['turn']} state={state}: stopped on purpose, not sending a follow-up", 2)
        rc, output = run_verify(run, meta)
        if rc == VERIFY_MISSING_RC and not Path(meta["verify"]).is_file():
            loop_fail(f"verify script {meta['verify']} not found", 2)
        print(f"turn {meta['turn']} state={state} verify rc={rc}", flush=True)
        if rc == 0 and state == "done":
            print("LOOP PASS")
            return
        if rc == 0 and state in ("crashed", "failed"):
            print(f"LOOP PASS (verify passed; worker turn ended {state})")
            return
        crashes += state == "crashed"
        if crashes > 1:
            loop_fail("LOOP FAIL (crashed twice)", 1)
        if attempt == args.max_fixes:
            break
        msg = FIX_TEMPLATE.format(rc=rc, output=output[-3000:], script=meta["verify"], workdir=meta["workdir"])
        if state != "done":
            msg = f"Your previous turn ended with state '{state}' (not a clean finish).\n\n" + msg
        cmd_followup(argparse.Namespace(id=args.id, message=msg, file=None, budget=None, raw=False))
    loop_fail("LOOP FAIL", 1)


# -------------------------------------------------------------------- review
RED_FLAGS = ["console.log(", "dbg!(", "println!(\"debug", "TODO", "FIXME", "breakpoint()", "pdb.set_trace"]
SCRATCH_PREFIX = ".hsa-tmp/"


def added_lines(workdir: str, base: str) -> list[str]:
    diff = git(workdir, "diff", base, "--unified=0")
    return [l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++")]


def untracked_lines(workdir: str) -> list[str]:
    """Lines of untracked text files (new files are not in `git diff`); big or binary files are skipped."""
    lines = []
    for rel in git(workdir, "ls-files", "-o", "--exclude-standard", "-z").split("\0"):
        path = Path(workdir) / rel
        if not rel or rel.startswith(SCRATCH_PREFIX):
            continue
        try:
            if not path.is_file() or path.stat().st_size > MAX_UNTRACKED_BYTES:
                continue
            lines.extend(path.read_text().splitlines())
        except (OSError, UnicodeDecodeError):
            continue
    return lines


def print_git_sections(meta: dict, base: str | None) -> None:
    wd = meta.get("workdir")
    if not wd:
        return
    if base:
        print("== commits\n" + (git(wd, "log", "--oneline", f"{base}..HEAD") or "(none)"))
        print("== diffstat (base..worktree)\n" + (git(wd, "diff", "--stat", base) or "(no changes)"))
        lines = added_lines(wd, base) + untracked_lines(wd)
        flags = sorted({f for line in lines for f in RED_FLAGS if f in line})
        print("== red flags in added lines: " + (", ".join(flags) or "none"))
    print("== uncommitted\n" + (git(wd, "status", "--short") or "(clean)"))


def cmd_review(args: argparse.Namespace) -> None:
    """One compact packet for the orchestrator: outcome, usage, commits, diffstat, flags, final report."""
    run = require_run(args.id)
    meta = refresh_session(run, run.meta())
    turn = meta.get("turn", 1)
    usage = read_usage(run, turn)
    print(f"== {args.id}  state={turn_state(run, meta)}  turn={turn}  exit={usage.get('turn_exit_reason')}"
          f"  calls={usage.get('api_calls')}  failed={usage.get('failed')}")
    print_git_sections(meta, args.base or meta.get("base"))
    if meta.get("verifications"):
        print("== verify history: " + ", ".join(f"t{v['turn']}:rc{v['rc']}" for v in meta["verifications"]))
    report = latest_report(run, meta)
    err = run.turn_file(turn, "err")
    if not report and err.exists():
        print("== stderr tail\n" + err.read_text()[-1500:])
    missing = [h for h in REPORT_HEADINGS if not re.search(rf"^\W*{re.escape(h)}\b", report, re.M)]
    if missing:
        print("== report missing headings: " + ", ".join(missing))
    print("== worker report\n" + (report[:args.chars] or "(empty)"))


REPORT_HEADINGS = ["STATUS", "COMMITS", "CHANGES", "ACCEPTANCE", "TESTS ADDED", "NOT DONE / RISKS"]
REPORT_START = re.compile(r"^\W*STATUS:", re.M)


def latest_report(run: Run, meta: dict) -> str:
    """The worker's structured report for the current turn. Usually the final answer; but Hermes configs with
    post-answer 'evidence' nudges can make the last message an evidence reply, so fall back to the newest
    assistant message of this turn that contains a STATUS: line."""
    out_file = run.turn_file(meta.get("turn", 1), "out")
    out = out_file.read_text() if out_file.exists() else ""
    match = REPORT_START.search(out)
    if match and match.start() < REPORT_SEARCH_PREFIX:
        return out[match.start():].strip()
    for role, content, _tool, _calls, ts in reversed(session_messages(meta.get("session_id"), REPORT_SCAN_MESSAGES)):
        if role != "assistant" or not content or (ts or 0) < (meta.get("turn_started_at") or 0):
            continue
        found = REPORT_START.search(content)
        if found:
            return content[found.start():].strip()
    return out.strip()


def cmd_report(args: argparse.Namespace) -> None:
    run = require_run(args.id)
    print(latest_report(run, refresh_session(run, run.meta())))


DOCTOR_PROBE_VALUE = "forwarded"
DOCTOR_PROMPT = ("Run exactly this one shell command with your terminal tool, then reply with only its raw "
                 "output and nothing else: echo \"probe=${HSA_DOCTOR_PROBE:-unset} ppid=$PPID "
                 "sid=${HERMES_SESSION_ID:-unset}\"")
DOCTOR_PROBE_TIMEOUT_S = 900
DOCTOR_VERSION_TIMEOUT_S = 120
DOCTOR_LINE = re.compile(r"probe=(\S+) ppid=(\d+)(?: sid=(\S+))?")


def doctor_static(timeout_s: int) -> bool:
    """Print setup checks that need no model call; True when a probe run can be attempted."""
    hermes = shutil.which(HERMES_BIN)
    print(f"hermes binary : {hermes or 'MISSING (install Hermes Agent or set HSA_HERMES_BIN)'}")
    if hermes:
        try:
            proc = subprocess.run([HERMES_BIN, "--version"], capture_output=True, text=True,
                                  timeout=min(timeout_s, DOCTOR_VERSION_TIMEOUT_S))
            text = (proc.stdout or proc.stderr).strip()
            print(f"hermes version: {text.splitlines()[0] if text else '?'}")
        except subprocess.TimeoutExpired:
            print("hermes version: hermes --version timed out")
    db = HERMES_HOME / "state.db"
    print(f"session store : {db} ({'readable' if db.exists() else 'not found: live tail/status/ghost detection off'})")
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    print(f"runs dir      : {RUNS_DIR} (writable)")
    return bool(hermes)


def doctor_probe(timeout_s: int) -> None:
    """One tiny real run: latency, whether client env reaches tools, and where tool commands execute."""
    probe_dir = RUNS_DIR / "_doctor" / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    probe_dir.mkdir(parents=True)
    usage_file = probe_dir / "usage.json"
    argv = [HERMES_BIN, "-z", DOCTOR_PROMPT, "--in", str(probe_dir), "--yolo", "--reasoning", "low",
            "-t", "terminal", "--usage-file", str(usage_file)]
    started = time.time()
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout_s,
                              env={**os.environ, "HSA_DOCTOR_PROBE": DOCTOR_PROBE_VALUE}, cwd=probe_dir)
    except subprocess.TimeoutExpired:
        print(f"probe run     : probe timed out after {timeout_s} s")
        return
    elapsed = time.time() - started
    usage = load_json_dict(usage_file)
    found = DOCTOR_LINE.search(proc.stdout)
    print(f"probe run     : rc={proc.returncode} in {elapsed:.0f}s, {usage.get('api_calls')} model calls, "
          f"model={usage.get('model')}")
    if not found:
        print("probe output  : unexpected; first lines:\n" + (proc.stdout or proc.stderr)[:600])
        return
    print_probe_findings(found, usage)


def print_probe_findings(found: re.Match, usage: dict) -> None:
    forwarded = found.group(1) == DOCTOR_PROBE_VALUE
    gateway = pid_alive(int(found.group(2)))
    tagged = bool(found.group(3)) and found.group(3) != "unset" and found.group(3) == usage.get("session_id")
    print(f"env forwarded : {'yes' if forwarded else 'NO - env vars set by hsa (timeouts) do not reach workers'}")
    print(f"tool host     : {'Hermes gateway (long-lived process)' if gateway else 'the hermes client process'}")
    print("session-tagged : " + ("yes (hsa stop kills exactly this worker's commands)" if tagged
                                else "no (hsa stop falls back to a cwd heuristic)"))
    if gateway:
        print("=> gateway-hosted: `hsa stop` kills the client and the worker's commands, but a turn can continue")
        print("   server-side (status 'ghost'). Keep tasks small; let turns finish and correct them with follow-ups.")
    else:
        print("=> in-process: `hsa stop` ends the run completely; --terminal-timeout/--budget are hard limits.")
    if not forwarded:
        print("=> long commands: workers must use background mode + process_manage wait (the preamble says so).")


def cmd_doctor(args: argparse.Namespace) -> None:
    if doctor_static(args.timeout) and not args.no_probe:
        doctor_probe(args.timeout)


def cmd_path(args: argparse.Namespace) -> None:
    print(require_run(args.id).dir if args.id else RUNS_DIR)


# ---------------------------------------------------------------------- main
def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="hsa", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("dispatch", help="start a worker on a brief (returns immediately)")
    d.add_argument("id"); d.add_argument("workdir"); d.add_argument("brief")
    d.add_argument("--verify", help="acceptance script run (bash, cwd=workdir) by `hsa verify/loop`")
    d.add_argument("--base", help="git base for review (default: current HEAD of workdir)")
    d.add_argument("-r", "--reasoning", default="high")
    d.add_argument("-m", "--model"); d.add_argument("--provider")
    d.add_argument("-t", "--toolsets"); d.add_argument("--skills")
    d.add_argument("--coding", action="store_true", help=f"toolsets preset for code work: {CODING_TOOLSETS}")
    d.add_argument("--budget", type=int, default=DEFAULT_BUDGET_S, help="hard wall clock per turn, seconds")
    d.add_argument("--terminal-timeout", type=int, default=DEFAULT_TERMINAL_TIMEOUT_S,
                   help="Hermes foreground command timeout (default 1200 s); only effective when Hermes runs "
                        "turns in-process (see `hsa doctor`)")
    d.add_argument("--verify-timeout", type=int, default=DEFAULT_VERIFY_TIMEOUT_S,
                   help="kill the verify script after this many seconds (default 1800)")
    d.add_argument("--clean", action="store_true", help="--ignore-rules: no AGENTS.md/memory/skills injection")
    d.add_argument("--no-preamble", action="store_true", help="send the brief without the worker preamble")
    d.add_argument("--share-workdir", action="store_true", help="allow a second worker in a busy workdir")
    d.add_argument("--force", action="store_true", help="replace an existing run with this id")
    d.set_defaults(fn=cmd_dispatch)

    f = sub.add_parser("followup", help="send another turn to a finished worker (same Hermes session)")
    f.add_argument("id"); f.add_argument("message", nargs="?"); f.add_argument("-f", "--file")
    f.add_argument("--budget", type=int)
    f.add_argument("--raw", action="store_true", help="send the message without the report-format reminder")
    f.set_defaults(fn=cmd_followup)

    s = sub.add_parser("status", help="table of runs"); s.add_argument("ids", nargs="*")
    s.add_argument("--active", action="store_true"); s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_status)

    t = sub.add_parser("tail", help="last N messages/tool calls of a run (live, from Hermes state.db)")
    t.add_argument("id"); t.add_argument("-n", type=int, default=12); t.set_defaults(fn=cmd_tail)

    w = sub.add_parser("wait", help="block until runs finish (use with run_in_background)")
    w.add_argument("ids", nargs="+"); w.add_argument("--any", action="store_true")
    w.add_argument("--timeout", type=int); w.set_defaults(fn=cmd_wait)

    v = sub.add_parser("verify", help="run the run's acceptance script now"); v.add_argument("id")
    v.set_defaults(fn=cmd_verify)

    lp = sub.add_parser("loop", help="wait+verify+auto-follow-up with failures until pass")
    lp.add_argument("id"); lp.add_argument("--max-fixes", type=int, default=3); lp.set_defaults(fn=cmd_loop)

    r = sub.add_parser("review", help="compact review packet: commits, diffstat, flags, final report")
    r.add_argument("id"); r.add_argument("--base"); r.add_argument("--chars", type=int, default=4000)
    r.set_defaults(fn=cmd_review)

    k = sub.add_parser("stop", help="kill a running worker's process group"); k.add_argument("id")
    k.set_defaults(fn=cmd_stop)

    g = sub.add_parser("worktree", help="git worktree add -b BRANCH for an isolated worker")
    g.add_argument("repo"); g.add_argument("branch"); g.add_argument("--base"); g.add_argument("--path")
    g.set_defaults(fn=cmd_worktree)

    rp = sub.add_parser("report", help="print the worker's structured report for the latest turn")
    rp.add_argument("id"); rp.set_defaults(fn=cmd_report)

    dr = sub.add_parser("doctor", help="check the setup; one tiny probe run reveals latency and hosting mode")
    dr.add_argument("--no-probe", action="store_true", help="skip the model call")
    dr.add_argument("--timeout", type=int, default=DOCTOR_PROBE_TIMEOUT_S)
    dr.set_defaults(fn=cmd_doctor)

    pa = sub.add_parser("path", help="print the runs dir, or one run's dir"); pa.add_argument("id", nargs="?")
    pa.set_defaults(fn=cmd_path)
    return p


def main() -> None:
    args = parser().parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
